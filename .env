# --- Docker Compose Specific Environment Variables ---

# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=your_strong_root_password_here # CHANGE THIS
MYSQL_DATABASE=your_database_name_here           # CHANGE THIS (e.g., db_inventaris_js)
MYSQL_USER=your_db_user_here                     # CHANGE THIS (e.g., app_user)
MYSQL_PASSWORD=your_db_user_password_here        # CHANGE THIS

# JWT Secret for Backend Authentication
JWT_SECRET=your_long_and_complex_jwt_secret_here # CHANGE THIS (use a strong random string)

# Other potential variables for frontend or backend builds/runtime
# VITE_API_BASE_URL=/api # This is set directly in docker-compose.yml for frontend build