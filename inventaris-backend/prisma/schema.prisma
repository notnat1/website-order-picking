// Lokasi: inventaris-backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  nama      String
  username  String   @unique
  password  String
  level     String   @default("manajemen") // "manajemen" or "gudang"
  status    String   @default("Aktif") // <-- Tambahan untuk Kualitas Data
  
  // Relasi ke Order (Assignment)
  assignedOrders Order[]
}

model Supplier {
  id            Int      @id @default(autoincrement())
  nama_supplier String   @unique
  alamat        String?
  telepon       String?
  status        String   @default("Aktif")
  barangMasuk   BarangMasuk[]
}

model Item { // Ini adalah Data Barang
  id          Int      @id @default(autoincrement())
  nama_barang String
  spesifikasi String?
  lokasi      String?
  kondisi     String
  jumlah_stok Int      @default(0)
  min_stok    Int      @default(5) // <-- Safety Stock
  sumber_dana String?
  status      String   @default("Aktif")

  // Relasi
  barangMasuk   BarangMasuk[]
  barangKeluar  BarangKeluar[]
  orderDetails OrderDetail[]
}

model BarangMasuk {
  id            Int      @id @default(autoincrement())
  tanggal_masuk DateTime @default(now())
  jumlah        Int
  item_id       Int
  item          Item     @relation(fields: [item_id], references: [id])
  supplier_id   Int
  supplier      Supplier @relation(fields: [supplier_id], references: [id])
}

model BarangKeluar { // Ini adalah Peminjaman / Audit Log
  id              Int       @id @default(autoincrement())
  tanggal_keluar  DateTime  @default(now())
  jumlah          Int
  penerima        String?    // Siapa yang pinjam/ambil (Nama Picker/Penerima Umum)
  tipe            String    @default("GENERAL") // <-- Tipe: PICKING, GENERAL, RUSAK
  
  // Relasi ke Order (jika tipe=PICKING)
  order_id        Int?
  order           Order?    @relation(fields: [order_id], references: [id])

  // Kunci relasi ke Item
  item_id         Int
  item            Item      @relation(fields: [item_id], references: [id])
}

// TABEL ORDER BARU #1
model Order {
  id            Int       @id @default(autoincrement())
  nomor_pesanan String    @unique
  nama_pemesan  String
  status        String    @default("Pending") 
  createdAt     DateTime  @default(now())
  
  // Fitur Picker Assignment
  picker_id     Int?
  picker        User?     @relation(fields: [picker_id], references: [id])
  
  // Relasi
  orderItems    OrderDetail[]
  barangKeluar  BarangKeluar[]
}

// TABEL ORDER DETAIL #2
model OrderDetail {
  id        Int   @id @default(autoincrement())
  jumlah    Int
  
  order_id  Int
  order     Order @relation(fields: [order_id], references: [id], onDelete: Cascade)
  
  item_id   Int
  item      Item  @relation(fields: [item_id], references: [id])
}